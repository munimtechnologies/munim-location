{
  "name": "munim-location",
  "version": "0.4.1",
  "description": "A comprehensive React Native location library: permissions, current and continuous positions, background and headless tracking, geofencing, iBeacons, heading, altimeter, GNSS, and geocoding for iOS and Android with Expo support",
  "main": "./lib/commonjs/index.js",
  "module": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "react-native": "src/index",
  "source": "src/index",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "typecheck:example": "tsc --noEmit -p example/tsconfig.json",
    "lint": "eslint src test example/App.tsx example/index.js example/src app.plugin.js eslint.config.js scripts",
    "test": "jest",
    "clean": "git clean -dfX",
    "release": "semantic-release",
    "build": "npm run typecheck && bob build",
    "codegen": "nitrogen --logLevel=\"debug\" && node scripts/patch-nitro-optionals.js && npm run build && node post-script.js",
    "bench:delivery": "node scripts/bench-delivery.mjs",
    "release:local": "node scripts/release-local.mjs"
  },
  "keywords": [
    "react-native",
    "expo",
    "location",
    "geolocation",
    "gps",
    "gnss",
    "geofencing",
    "geofence",
    "background-location",
    "headless",
    "significant-location-change",
    "visits",
    "ibeacon",
    "heading",
    "compass",
    "altimeter",
    "geocoding",
    "reverse-geocoding",
    "fused-location-provider",
    "core-location",
    "nmea",
    "ios",
    "android",
    "typescript",
    "nitro-modules",
    "munim-technologies"
  ],
  "files": [
    "src",
    "react-native.config.js",
    "lib",
    "nitrogen",
    "nitro.json",
    "android/build.gradle",
    "android/consumer-rules.pro",
    "android/fix-prefab.gradle",
    "android/gradle.properties",
    "android/CMakeLists.txt",
    "android/src",
    "ios/**/*.h",
    "ios/**/*.m",
    "ios/**/*.mm",
    "ios/**/*.cpp",
    "ios/**/*.swift",
    "app.plugin.js",
    "docs",
    "*.podspec",
    "README.md",
    "CHANGELOG.md"
  ],
  "workspaces": [
    "example"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/munimtechnologies/munim-location.git"
  },
  "author": "sheehanmunim <support@munimtech.com> (https://github.com/sheehanmunim)",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/munimtechnologies/munim-location/issues"
  },
  "homepage": "https://github.com/munimtechnologies/munim-location#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "expo": {
    "name": "munim-location",
    "platforms": [
      "ios",
      "android"
    ],
    "install": {
      "exclude": [
        "react-native"
      ]
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@expo/config-plugins": "^58.0.13",
    "@react-native/gradle-plugin": "^0.88.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.3.0",
    "conventional-changelog-conventionalcommits": "^10.4.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "nitrogen": "0.37.2",
    "prettier": "^3.10.1",
    "react": "19.3.1",
    "react-native": "0.88.1",
    "react-native-builder-bob": "^0.44.1",
    "react-native-nitro-modules": "0.37.2",
    "semantic-release": "^26.0.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*",
    "react-native-nitro-modules": ">=0.36.5 <1"
  },
  "overrides": {
    "brace-expansion@1.x": "1.1.21",
    "brace-expansion@2.x": "2.1.7",
    "brace-expansion@>=3 <6": "5.0.12",
    "ip-address@10.x": "10.7.3",
    "joi@17.x": "17.13.8",
    "js-yaml@3.x": "3.15.2",
    "js-yaml@4.x": "4.3.2",
    "tar@7.x": "7.5.22",
    "undici@6.x": "6.29.1",
    "undici@7.x": "7.30.2",
    "@semantic-release/npm": {
      "npm": "npm:@semantic-release/error@4.0.0"
    }
  },
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false,
    "semi": false
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.json"
        }
      ]
    ]
  },
  "jest": {
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/test"
    ]
  }
}
